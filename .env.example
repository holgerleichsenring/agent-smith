# Agent Smith - Environment Variables
# Copy this file to .env and fill in your values.
# Only the keys relevant to your configured agent/source/ticket types are needed.

# --- AI Provider API Keys (at least one, depending on agent.type in config) ---
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# AZURE_OPENAI_API_KEY=...
# GEMINI_API_KEY=...
# GROQ_API_KEY=gsk_...

# --- Source / Ticket Provider Tokens (depending on source.type / tickets.type) ---
# GITHUB_TOKEN=ghp_...
# AZURE_DEVOPS_TOKEN=...
# GITLAB_TOKEN=glpat-...
# GITLAB_URL=https://gitlab.com
# GITLAB_PROJECT=mygroup/myproject

# --- Jira (required if tickets.type is "jira") ---
# JIRA_URL=https://mycompany.atlassian.net
# JIRA_EMAIL=user@example.com
# JIRA_TOKEN=...
# JIRA_WEBHOOK_SECRET=...

# --- Webhook shared secrets (optional; set the same value on the platform's webhook) ---
# Once a platform's secret is set, an UNSIGNED delivery for that platform is refused.
# Leave one unset and that platform stays open — set them on any host reachable from
# the internet.
# GITHUB_WEBHOOK_SECRET=...
# GITLAB_WEBHOOK_TOKEN=...
# AZDO_WEBHOOK_SECRET=...

# --- Token authority (optional; p0503b) ---
# The single OIDC issuer a presented bearer token is validated against, and the
# switch that decides whether the permission every route declares may refuse.
# Set no authority and nothing authenticates, exactly as before. Set an authority
# with AGENTSMITH_AUTH_ENFORCE unset and a presented token is validated but no
# route is refused — which is how you prepare an authority without locking anyone out.
# AGENTSMITH_AUTH_AUTHORITY=https://login.example.com/realms/agentsmith
# AGENTSMITH_AUTH_AUDIENCE=agent-smith
# AGENTSMITH_AUTH_ENFORCE=false
