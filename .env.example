# Agent Smith - Environment Variables
# Copy this file to .env and fill in your values.
# Only the keys relevant to your configured agent/source/ticket types are needed.

# --- AI Provider API Keys (at least one, depending on agent.type in config) ---
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# AZURE_OPENAI_API_KEY=...
# GEMINI_API_KEY=...
# GROQ_API_KEY=gsk_...

# --- Source / Ticket Provider Tokens (depending on source.type / tickets.type) ---
# GITHUB_TOKEN=ghp_...
# AZURE_DEVOPS_TOKEN=...
# GITLAB_TOKEN=glpat-...
# GITLAB_URL=https://gitlab.com
# GITLAB_PROJECT=mygroup/myproject

# --- Jira (required if tickets.type is "jira") ---
# JIRA_URL=https://mycompany.atlassian.net
# JIRA_EMAIL=user@example.com
# JIRA_TOKEN=...
# JIRA_WEBHOOK_SECRET=...

# --- Webhook shared secrets (optional; set the same value on the platform's webhook) ---
# Once a platform's secret is set, an UNSIGNED delivery for that platform is refused.
# Leave one unset and that platform stays open — set them on any host reachable from
# the internet.
# GITHUB_WEBHOOK_SECRET=...
# GITLAB_WEBHOOK_TOKEN=...
# AZDO_WEBHOOK_SECRET=...

# --- Token authority (optional; p0503b) ---
# The single OIDC issuer a presented bearer token is validated against, and the
# switch that decides whether the permission every route declares may refuse.
# Set no authority and nothing authenticates, exactly as before. Set an authority
# with AGENTSMITH_AUTH_ENFORCE unset and a presented token is validated but no
# route is refused — which is how you prepare an authority without locking anyone out.
# AGENTSMITH_AUTH_AUTHORITY=https://login.example.com/realms/agentsmith
# AGENTSMITH_AUTH_AUDIENCE=agent-smith
# AGENTSMITH_AUTH_ENFORCE=false

# --- What the BROWSER needs to reach that authority (optional; 2026-08-25-21ae) ---
# The dashboard image's entrypoint writes these into a document the browser fetches
# at boot, so changing one is a restart of the dashboard container and never a
# rebuild of its image. Set none and the dashboard behaves exactly as it did before.
# NOTHING SECRET GOES HERE — that document is served to any browser that asks. A
# public client id, an authority and a scope list are public values; a client secret
# is not, and no code path could tell the difference.
# AUTHORITY and AUDIENCE are the same two variables the server reads above, on
# purpose: one value, both services, no drift.
# AGENTSMITH_AUTH_CLIENT_ID=agentsmith-dashboard
# AGENTSMITH_AUTH_SCOPES=openid profile
# AGENTSMITH_AUTH_REDIRECT_PATH=/signin-callback

# --- Which claims say who you are (optional; p0503d) ---
# The identity provider decides WHO holds a role; the auth block in agentsmith.yml
# decides what a role MEANS. These three name the claims to read it out of. The group
# mapping and any custom roles are structure, so they stay in the config file.
# AGENTSMITH_AUTH_ROLE_CLAIM=roles
# AGENTSMITH_AUTH_GROUP_CLAIM=groups
# AGENTSMITH_AUTH_NAME_CLAIM=sub

# --- The way back in (optional; p0503d) ---
# A comma-separated list of callers who hold the admin role whatever the directory says,
# so a wrong mapping cannot lock every human out of the surface that fixes it. Every
# entry names the claim it is matched against — group:<value> or sub:<value> — because a
# grant tried across claim types turns any claim colliding with the value into an admin.
# It reaches no editable surface: it is changed where the deployment is.
# AGENTSMITH_ADMIN_GRANT=sub:00000000-0000-0000-0000-000000000000,group:platform-admins
