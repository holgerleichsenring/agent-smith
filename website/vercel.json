{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "_site",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "agent-smith.org"
        }
      ],
      "destination": "https://www.codeably.ai/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "agent-smith.org"
        }
      ],
      "destination": "https://www.codeably.ai/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.agent-smith.org"
        }
      ],
      "destination": "https://www.codeably.ai/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.agent-smith.org"
        }
      ],
      "destination": "https://www.codeably.ai/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "docs.agent-smith.org"
        }
      ],
      "destination": "https://docs.codeably.ai/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "docs.agent-smith.org"
        }
      ],
      "destination": "https://docs.codeably.ai/:path*",
      "permanent": true
    }
  ]
}
