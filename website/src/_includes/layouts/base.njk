<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="color-scheme" content="dark">
{%- set pageTitle = title or (site.title + " — " + site.tagline) -%}
{%- set pageDescription = description or site.description -%}
{%- set pageUrl = site.url + (page.url | canonicalPath) -%}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDescription }}">
<link rel="canonical" href="{{ pageUrl }}">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="stylesheet" href="/styles.css">
<link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt">
{%- if legalReady %}
<script src="/consent.js" defer></script>
{%- endif %}
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:url" content="{{ pageUrl }}">
<meta property="og:image" content="{{ site.image }}">
<meta property="og:image:alt" content="Agent Smith, the agentic software factory">
<meta property="og:locale" content="en_US">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDescription }}">
<meta name="twitter:image" content="{{ site.image }}">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "{{ site.url }}/#author",
      "name": {{ site.author | dump | safe }},
      "url": "{{ site.authorUrl }}",
      "sameAs": ["{{ site.authorUrl }}", "{{ site.blogUrl }}"]
    },
    {
      "@type": "SoftwareApplication",
      "@id": "{{ site.url }}/#software",
      "name": {{ site.title | dump | safe }},
      "alternateName": "Agent Smith agentic software factory",
      "description": {{ site.description | dump | safe }},
      "url": "{{ site.url }}/",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Cross-platform (.NET 8), Docker, Kubernetes",
      "license": "https://opensource.org/licenses/MIT",
      "isAccessibleForFree": true,
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "codeRepository": "https://github.com/{{ site.githubRepo }}",
      "softwareHelp": "{{ site.docsUrl }}/",
      "image": "{{ site.image }}",
      "author": { "@id": "{{ site.url }}/#author" },
      "creator": { "@id": "{{ site.url }}/#author" },
      "maintainer": { "@id": "{{ site.url }}/#author" },
      "copyrightHolder": { "@id": "{{ site.url }}/#author" },
      "copyrightYear": 2026
    },
    {
      "@type": "WebSite",
      "@id": "{{ site.url }}/#website",
      "name": {{ site.title | dump | safe }},
      "url": "{{ site.url }}/",
      "author": { "@id": "{{ site.url }}/#author" }
    }
    {%- if servicesProvider %},
    {
      "@type": "ProfessionalService",
      "@id": "{{ site.partnerUrl }}/#services",
      "name": {{ site.partner | dump | safe }},
      "url": "{{ site.partnerUrl }}",
      "description": "Professional services, support and maintenance contracts for Agent Smith.",
      "areaServed": "Worldwide",
      "makesOffer": {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Agent Smith professional services and maintenance contracts",
          "about": { "@id": "{{ site.url }}/#software" }
        }
      }
    }
    {%- endif %}
  ]
}
</script>
</head>
<body>
{%- if legalReady %}

<section class="consent" id="consent" role="dialog" aria-labelledby="consent-h" aria-describedby="consent-p" tabindex="-1" hidden>
  <h2 id="consent-h">May we count your visit?</h2>
  <p id="consent-p">We'd like to use Google Analytics to see how many people visit and which pages they read. It sets cookies and sends data to Google. Nothing loads unless you say yes, and you can change your mind under Privacy settings at the bottom of every page.</p>
  <div class="consent-row">
    <button class="btn" id="consent-decline" type="button">Decline</button>
    <button class="btn" id="consent-accept" type="button">Accept</button>
  </div>
  <div class="consent-fine">Details in the <a href="/privacy/">privacy policy</a>.</div>
</section>
{%- endif %}

<nav class="nav" aria-label="Main">
  <div class="wrap">
    <a class="logo" href="/"><i aria-hidden="true"></i>agent-smith</a>
    <ul>
      <li><a href="/#define">How it works</a></li>
      <li><a href="/azure-devops/">Azure DevOps</a></li>
      <li><a href="/#why">Why</a></li>
      <li><a href="/#built">How it was built</a></li>
      <li><a href="/services/">Services</a></li>
      <li><a href="{{ site.docsUrl }}">Docs</a></li>
      <li><a href="https://github.com/{{ site.githubRepo }}">GitHub</a></li>
    </ul>
    <a class="btn btn-go btn-sm" href="{{ site.docsUrl }}/get-it-running/install/">Get started</a>
  </div>
</nav>

{{ content | safe }}

<footer class="footer">
  <div class="wrap">
    <span>Agent Smith · an open source project led by {{ site.author }} · <a href="{{ site.partnerUrl }}">professional services by 45level</a> · MIT License · © 2026 {{ site.author }}</span>
    <span class="footer-links">
      <a href="{{ site.docsUrl }}">Docs</a>
      <a href="{{ site.sentinelUrl }}">Sentinel</a>
      <a href="https://github.com/{{ site.githubRepo }}">GitHub</a>
      <a href="{{ site.blogUrl }}">Blog</a>
      {%- if legalReady %}
      <a href="/privacy/">Privacy</a>
      {%- if imprintReady %}
      <a href="/imprint/">Imprint</a>
      {%- endif %}
      <a href="/privacy/#settings" data-consent-settings>Privacy settings</a>
      {%- endif %}
    </span>
  </div>
</footer>

<script src="/main.js"></script>
</body>
</html>
