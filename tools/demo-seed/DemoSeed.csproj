<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Docs screenshot rig: writes the demo story into a scratch database through the server's own
       composition. Not part of AgentSmith.sln and never shipped; see tools/screenshots/README.md. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DemoSeed</RootNamespace>
    <AssemblyName>DemoSeed</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\backend\AgentSmith.Server\AgentSmith.Server.csproj" />
  </ItemGroup>

</Project>
