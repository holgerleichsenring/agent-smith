<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="8.8.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.7" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="Testcontainers.Redis" Version="3.10.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- 2026-09-22-3f7c: the suite's wall-clock vocabulary and its thread-pool floor are
       shared source, not a shared assembly — this project must not take a reference on the
       backend test project to borrow two files. -->
  <ItemGroup>
    <Compile Include="..\AgentSmith.Tests\TestHelpers\TestWaits.cs" Link="TestHelpers\TestWaits.cs" />
    <Compile Include="..\AgentSmith.Tests\Architecture\TestHostThreadPool.cs" Link="TestHelpers\TestHostThreadPool.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\backend\AgentSmith.Sandbox.Agent\AgentSmith.Sandbox.Agent.csproj" />
    <ProjectReference Include="..\..\src\backend\AgentSmith.Sandbox.Wire\AgentSmith.Sandbox.Wire.csproj" />
  </ItemGroup>

</Project>
