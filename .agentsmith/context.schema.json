{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/holger/ccs/context.schema.json",
  "title": "Compact Context Specification",
  "description": "Token-efficient project context for AI assistants. Drop a .context.yaml in your repo root.",
  "type": "object",
  "$comment": "2026-08-25-056d: only meta is required, because meta is the only block the typed writer (ContextYamlDocument) always emits — and inside it only workdir, the one field the runtime genuinely enforces. state is written by the methodology, never by the writer, so requiring it would refuse every freshly bootstrapped context.",
  "required": [
    "meta"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "description": "Project identity",
      "required": [
        "workdir"
      ],
      "additionalProperties": false,
      "properties": {
        "project": {
          "type": "string",
          "description": "Repository or solution name",
          "examples": [
            "agent-smith",
            "order-service"
          ]
        },
        "workdir": {
          "type": "string",
          "description": "Sub-tree this context applies to, relative to the repo root. '.' = repo root (single-stack default, contexts/default/). Monorepo example: 'src/Server', 'client', 'docs'. Required per p0161 — sandbox coordinator clones at this path so /work = sub-tree root inside the sandbox.",
          "examples": [".", "src/Server", "client", "docs"]
        },
        "version": {
          "type": "string",
          "description": "Current project version (semver)",
          "pattern": "^\\d+\\.\\d+\\.\\d+",
          "examples": [
            "1.0.0",
            "3.2.0"
          ]
        },
        "type": {
          "type": "array",
          "description": "System archetypes, pick 1-3",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string",
            "enum": [
              "crud",
              "api",
              "pipeline",
              "worker",
              "event",
              "stream",
              "agent",
              "ui",
              "platform",
              "rules"
            ]
          }
        },
        "purpose": {
          "type": "string",
          "description": "One sentence, max 100 chars: what it does, for whom",
          "maxLength": 100
        },
        "repo": {
          "type": "string",
          "description": "Repository URL (optional)"
        },
        "domain": {
          "type": "string",
          "description": "p0504: one word naming a profile in the skills catalog (profiles/<name>/profile.yaml). The profile supplies the toolchain image this context's sandbox runs in when stack.image is absent, and the ordered verification commands the repository is gated by. An unknown domain refuses the run before any sandbox is created.",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "examples": ["data-warehouse", "mobile"]
        }
      }
    },
    "methodology": {
      "type": "object",
      "description": "Which release of the Specification-First methodology this context was bootstrapped against. Written by bootstrap-project and read by update-project to decide whether the templates need syncing.",
      "required": [
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "description": "Plugin version from .claude-plugin/plugin.json (semver)",
          "pattern": "^\\d+\\.\\d+\\.\\d+",
          "examples": [
            "2.1.0"
          ]
        }
      }
    },
    "stack": {
      "type": "object",
      "description": "Technology choices",
      "$comment": "2026-08-25-056d: nothing here is required. ContextYamlStack models every field as nullable, so a stack the writer emits may name an image and a language and no runtime at all.",
      "additionalProperties": false,
      "properties": {
        "runtime": {
          "type": "string",
          "description": "Primary runtime/framework",
          "examples": [
            ".NET 8",
            ".NET 9",
            "Node.js 20",
            "Node.js 22",
            "Python 3.12",
            "Java 21",
            "Go 1.22",
            "Rust 1.75",
            "Ruby 3.3",
            "PHP 8.3",
            "Deno 2",
            "Bun 1"
          ]
        },
        "lang": {
          "type": "string",
          "description": "Primary language",
          "examples": [
            "C#",
            "TypeScript",
            "JavaScript",
            "Python",
            "Java",
            "Kotlin",
            "Go",
            "Rust",
            "Ruby",
            "PHP",
            "Swift",
            "Dart"
          ]
        },
        "image": {
          "type": "string",
          "description": "p0265: exact sandbox toolchain Docker image whose runtime can BOTH build and run this stack's tests. Must be from a trusted registry (mcr.microsoft.com, ghcr.io, or a Docker Hub official-library image) and a git-bearing tag (full -bookworm/-bullseye, an mcr .../sdk tag, or buildpack-deps:...-scm). Wins over the language convention table.",
          "examples": [
            "mcr.microsoft.com/dotnet/sdk:8.0",
            "mcr.microsoft.com/dotnet/sdk:9.0",
            "node:20-bookworm",
            "python:3.12-bookworm",
            "golang:1.22-bookworm"
          ]
        },
        "resources": {
          "type": "object",
          "description": "p0268: per-stack sandbox CPU/memory as Kubernetes quantities. Sizes the sandbox between the operator project override and the global default. All four fields are required together or omit the block entirely.",
          "additionalProperties": false,
          "required": [
            "cpu_request",
            "cpu_limit",
            "memory_request",
            "memory_limit"
          ],
          "properties": {
            "cpu_request": {
              "type": "string",
              "description": "Kubernetes CPU request, e.g. '500m' (heavy build) or '100m' (passive scan).",
              "examples": ["100m", "250m", "500m"]
            },
            "cpu_limit": {
              "type": "string",
              "description": "Kubernetes CPU limit, e.g. '2' (heavy build) or '500m' (passive scan).",
              "examples": ["500m", "1", "2"]
            },
            "memory_request": {
              "type": "string",
              "description": "Kubernetes memory request, e.g. '1Gi' (heavy build) or '256Mi' (passive scan).",
              "examples": ["256Mi", "512Mi", "1Gi"]
            },
            "memory_limit": {
              "type": "string",
              "description": "Kubernetes memory limit (OOM cap), e.g. '4Gi' (heavy build) or '512Mi' (passive scan).",
              "examples": ["512Mi", "2Gi", "4Gi"]
            }
          }
        },
        "frameworks": {
          "type": "array",
          "description": "Application frameworks this stack is built on. Emitted by the typed writer (ContextYamlStack.Frameworks) since p0193 and declared here only in 2026-08-25-056d — for everything in between, a context that named its frameworks failed the schema its own writer emits. Third field to drift this way after p0265's stack.image and p0272's prerequisites.",
          "items": {
            "type": "string",
            "examples": [
              "ASP.NET-Core",
              "Spring-Boot",
              "Django",
              "FastAPI",
              "Express",
              "NestJS",
              "Rails",
              "Laravel",
              "Gin"
            ]
          }
        },
        "frontend": {
          "type": "array",
          "description": "Frontend frameworks and tools",
          "items": {
            "type": "string",
            "examples": [
              "React",
              "Next.js",
              "Vue",
              "Nuxt",
              "Angular",
              "Svelte",
              "SvelteKit",
              "Blazor",
              "HTMX",
              "Astro",
              "Remix",
              "TypeScript",
              "JavaScript",
              "Tailwind",
              "Bootstrap",
              "MUI",
              "shadcn",
              "Vite",
              "Webpack",
              "esbuild"
            ]
          }
        },
        "infra": {
          "type": "array",
          "description": "Infrastructure and deployment",
          "items": {
            "type": "string",
            "examples": [
              "Docker",
              "K8s",
              "Docker-Compose",
              "AWS-ECS",
              "AWS-Lambda",
              "AWS-Fargate",
              "Azure-AppService",
              "Azure-Functions",
              "Azure-ContainerApps",
              "GCP-CloudRun",
              "GCP-GKE",
              "Vercel",
              "Netlify",
              "Fly.io",
              "Railway",
              "Terraform",
              "Pulumi",
              "Nginx",
              "Traefik",
              "Caddy",
              "SQL-Server",
              "PostgreSQL",
              "MySQL",
              "MongoDB",
              "DynamoDB",
              "CosmosDB",
              "Redis",
              "Memcached",
              "RabbitMQ",
              "Kafka",
              "SQS",
              "Azure-ServiceBus",
              "Redis-Streams",
              "S3",
              "Azure-Blob",
              "GCS",
              "Elasticsearch",
              "OpenSearch"
            ]
          }
        },
        "testing": {
          "type": "array",
          "description": "Testing frameworks and tools",
          "items": {
            "type": "string",
            "examples": [
              "xUnit",
              "NUnit",
              "MSTest",
              "Moq",
              "NSubstitute",
              "FluentAssertions",
              "Bogus",
              "Testcontainers",
              "Jest",
              "Vitest",
              "Playwright",
              "Cypress",
              "Testing-Library",
              "pytest",
              "unittest",
              "hypothesis",
              "JUnit",
              "Mockito",
              "Testcontainers",
              "Storybook",
              "Chromatic"
            ]
          }
        },
        "ci": {
          "type": "array",
          "description": "CI/CD platforms",
          "items": {
            "type": "string",
            "examples": [
              "GitHub-Actions",
              "Azure-DevOps-Pipelines",
              "GitLab-CI",
              "Jenkins",
              "CircleCI",
              "Travis-CI",
              "Bitbucket-Pipelines",
              "ArgoCD",
              "FluxCD",
              "Octopus-Deploy"
            ]
          }
        },
        "sdks": {
          "type": "array",
          "description": "Significant SDKs and libraries",
          "items": {
            "type": "string",
            "examples": [
              "Anthropic",
              "OpenAI",
              "Google-Gemini",
              "Azure-OpenAI",
              "Octokit",
              "LibGit2Sharp",
              "Azure-DevOps",
              "EF-Core",
              "Dapper",
              "Prisma",
              "Drizzle",
              "SQLAlchemy",
              "MediatR",
              "MassTransit",
              "Rebus",
              "Wolverine",
              "Polly",
              "Hangfire",
              "Quartz.NET",
              "AutoMapper",
              "Mapster",
              "FluentValidation",
              "SignalR",
              "gRPC",
              "GraphQL-HotChocolate",
              "Serilog",
              "NLog",
              "OpenTelemetry",
              "YamlDotNet",
              "Newtonsoft.Json"
            ]
          }
        }
      }
    },
    "prerequisites": {
      "type": "string",
      "description": "Operator-owned setup command run ONCE before the coding agent gets control (EnsurePrerequisitesHandler), in the same sandbox so its effects persist to later steps. Typically a dependency install (npm ci, dotnet restore). p0272: it can also carry an auth command that consumes operator-injected sandbox.secrets — wrap it in `sh -c \"…\"` so the pod's shell expands the env vars (the handler tokenizes and runs without a shell, so a bare $VAR would not expand), and reference the secrets by name, never by value.",
      "examples": [
        "npm ci",
        "sh -c \"sf org login jwt --client-id $SF_CLIENT_ID --jwt-key-file /secrets/server.key --username $SF_USERNAME --alias devhub\""
      ]
    },
    "arch": {
      "type": "object",
      "description": "Architecture and code organization",
      "$comment": "2026-08-25-056d: the writer models arch as a freeform map (ContextYamlDocument.Arch), exactly like quality and behavior, so neither a required key nor a closed key set can be honoured by anything that emits one. The properties below stay as the shape worth writing; they are guidance, not a gate.",
      "additionalProperties": true,
      "properties": {
        "style": {
          "type": "array",
          "description": "Architecture styles",
          "items": {
            "type": "string",
            "enum": [
              "CleanArch",
              "Hexagonal",
              "Onion",
              "Layered",
              "Vertical-Slice",
              "DDD",
              "CQRS",
              "Event-Sourcing",
              "Microservices",
              "Modular-Monolith",
              "Monolith",
              "Serverless",
              "SOA",
              "MVC",
              "MVVM",
              "Flux",
              "EDA"
            ]
          }
        },
        "patterns": {
          "type": "array",
          "description": "Key design patterns used",
          "items": {
            "type": "string",
            "enum": [
              "Repository",
              "UnitOfWork",
              "MediatR",
              "CQRS-Handlers",
              "Command/Handler",
              "Factory",
              "Abstract-Factory",
              "Strategy",
              "Observer",
              "Decorator",
              "Middleware",
              "Pipeline",
              "Chain-of-Responsibility",
              "Specification",
              "State-Machine",
              "Saga",
              "Outbox",
              "Circuit-Breaker",
              "Retry",
              "Bulkhead",
              "Gateway",
              "Proxy",
              "Adapter",
              "Port/Adapter",
              "Mediator",
              "Pub/Sub",
              "Event-Bus",
              "Domain-Events",
              "Integration-Events",
              "Aggregate-Root",
              "Value-Object",
              "Entity",
              "DTO",
              "REPR",
              "MediatR-Command/Handler",
              "Repository/UnitOfWork"
            ]
          }
        },
        "layers": {
          "type": "array",
          "description": "Code layers, ordered inner to outer. Use # comments for one-line explanation.",
          "items": {
            "type": "string"
          },
          "examples": [
            [
              "Domain",
              "Application",
              "Infrastructure",
              "Host"
            ],
            [
              "Domain",
              "Application",
              "Infrastructure",
              "API",
              "Web"
            ],
            [
              "Domain",
              "Ports",
              "Adapters",
              "App"
            ],
            [
              "Models",
              "Services",
              "Controllers",
              "Views"
            ]
          ]
        },
        "bounded-contexts": {
          "type": "array",
          "description": "DDD bounded contexts (optional)",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "behavior": {
      "type": "object",
      "description": "What the system does. Include only sections that apply. Keys match meta.type archetypes.",
      "additionalProperties": true,
      "properties": {
        "api": {
          "type": "object",
          "properties": {
            "style": {
              "type": "string",
              "enum": [
                "REST",
                "GraphQL",
                "gRPC",
                "minimal-api",
                "JSON-RPC",
                "WebSocket",
                "OData"
              ]
            },
            "auth": {
              "type": "array",
              "items": {
                "type": "string",
                "examples": [
                  "JWT",
                  "OAuth2",
                  "API-Key",
                  "Basic",
                  "AzureAD",
                  "AzureAD-B2C",
                  "Auth0",
                  "Cognito",
                  "Keycloak",
                  "Cookie",
                  "Session",
                  "mTLS"
                ]
              }
            },
            "groups": {
              "type": "object",
              "description": "Endpoints grouped by domain",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "pipeline": {
          "type": "object",
          "description": "Named pipelines with triggers and steps",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "trigger": {
                "type": "array",
                "items": {
                  "type": "string",
                  "examples": [
                    "cli",
                    "webhook",
                    "schedule",
                    "manual",
                    "slack",
                    "teams",
                    "api-call",
                    "file-watch",
                    "queue"
                  ]
                }
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "error": {
                "type": "string",
                "enum": [
                  "stop-on-first-failure",
                  "skip-and-log",
                  "retry-3x",
                  "dead-letter",
                  "compensate"
                ]
              }
            }
          }
        },
        "worker": {
          "type": "object",
          "description": "Named background workers",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "schedule": {
                "type": "string"
              },
              "does": {
                "type": "string",
                "maxLength": 80
              }
            }
          }
        },
        "listener": {
          "type": "object",
          "description": "Named event listeners",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "on": {
                "type": "string"
              },
              "does": {
                "type": "string",
                "maxLength": 80
              },
              "protocol": {
                "type": "string",
                "examples": [
                  "HTTP-POST",
                  "WebSocket",
                  "gRPC-stream",
                  "RabbitMQ",
                  "Kafka",
                  "SQS",
                  "Azure-ServiceBus",
                  "Redis-Streams",
                  "NATS",
                  "Slack-Events-API",
                  "Teams-Bot-Framework",
                  "MQTT",
                  "AMQP",
                  "STOMP"
                ]
              }
            }
          }
        },
        "ui": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "SPA",
                "SSR",
                "MPA",
                "PWA",
                "mobile",
                "desktop",
                "CLI",
                "hybrid"
              ]
            },
            "framework": {
              "type": "string"
            },
            "state": {
              "type": "array",
              "items": {
                "type": "string",
                "examples": [
                  "React-Query",
                  "TanStack-Query",
                  "SWR",
                  "Redux",
                  "Redux-Toolkit",
                  "Zustand",
                  "Jotai",
                  "Recoil",
                  "MobX",
                  "Pinia",
                  "Vuex",
                  "NgRx",
                  "Akita",
                  "Svelte-Stores",
                  "Context-API",
                  "Signals"
                ]
              }
            },
            "pages": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "auth": {
              "type": "string"
            }
          }
        },
        "agent": {
          "type": "object",
          "description": "Agentic behavior (autonomous, goal-driven)",
          "additionalProperties": true
        },
        "stream": {
          "type": "object",
          "description": "Stream processing behavior",
          "additionalProperties": true
        },
        "rules": {
          "type": "object",
          "description": "Rule engine behavior",
          "additionalProperties": true
        }
      }
    },
    "quality": {
      "type": "object",
      "description": "Coding standards (compact form)",
      "additionalProperties": true,
      "properties": {
        "lang": {
          "type": "string",
          "enum": [
            "english-only",
            "german-allowed",
            "multilingual"
          ],
          "description": "Language policy for code, comments, commits"
        },
        "limits": {
          "type": "object",
          "properties": {
            "method-lines": {
              "type": "integer"
            },
            "class-lines": {
              "type": "integer"
            },
            "types-per-file": {
              "type": "integer"
            },
            "file-lines": {
              "type": "integer"
            }
          }
        },
        "principles": {
          "type": "array",
          "items": {
            "type": "string",
            "examples": [
              "SOLID",
              "DRY",
              "KISS",
              "YAGNI",
              "TellDontAsk",
              "GuardClauses",
              "NullSafety",
              "Immutability",
              "CompositionOverInheritance",
              "ProgramToInterface",
              "FailFast",
              "DefensiveCoding",
              "SingleLevelOfAbstraction"
            ]
          }
        },
        "naming": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "testing": {
          "type": "object",
          "properties": {
            "style": {
              "type": "string",
              "enum": [
                "AAA",
                "GWT",
                "BDD",
                "TDD"
              ]
            },
            "naming": {
              "type": "string"
            },
            "coverage": {
              "type": "string"
            }
          }
        }
      }
    },
    "integrations": {
      "type": "object",
      "description": "External systems",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "inbound",
              "outbound",
              "bidirectional",
              "storage"
            ]
          },
          "protocol": {
            "type": "string"
          },
          "does": {
            "type": "string",
            "description": "One line: what this integration is for.",
            "maxLength": 120
          },
          "providers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pattern": {
            "type": "string"
          }
        }
      }
    },
    "data": {
      "type": "object",
      "description": "Persistence and storage",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "engine": {
            "type": "string"
          },
          "orm": {
            "type": "string"
          },
          "migrations": {
            "type": "string",
            "enum": [
              "code-first",
              "db-first",
              "sql-scripts",
              "auto",
              "none"
            ]
          },
          "key-entities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pattern": {
            "type": "string"
          },
          "does": {
            "type": "string"
          },
          "ttl": {
            "type": "string"
          },
          "content": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "state": {
      "type": "object",
      "description": "Project progress",
      "required": [
        "done",
        "active"
      ],
      "additionalProperties": false,
      "properties": {
        "done": {
          "type": "object",
          "description": "Completed work. Key = version/phase, value = an index line: what shipped, in what area, and the pointer into phases/done/. The cap is 400 characters, ratcheted per entry by PhaseRecordLengthRatchetTests; 3000 is the absolute ceiling no entry may exceed, baselined or not.",
          "additionalProperties": {
            "type": "string",
            "maxLength": 3000
          }
        },
        "active": {
          "type": "object",
          "description": "Current work. Key = version/phase",
          "additionalProperties": {
            "type": "object",
            "required": [
              "goal"
            ],
            "properties": {
              "goal": {
                "type": "string",
                "maxLength": 80
              },
              "components": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "flow": {
                "type": "string"
              },
              "deps": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "blocked-by": {
                "type": "string"
              }
            }
          }
        },
        "planned": {
          "type": "object",
          "description": "Future work. Key = version/phase, value = the intent, held to the same 3000-character ceiling as a done entry.",
          "additionalProperties": {
            "type": "string",
            "maxLength": 3000
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "description": "Architecture Decision Records (compact)",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ADR-\\d{3}$"
          },
          "title": {
            "type": "string",
            "maxLength": 60
          },
          "reason": {
            "type": "string",
            "maxLength": 100
          }
        }
      }
    },
    "registry_auth": {
      "type": "object",
      "description": "p0375: templated private-registry auth staging. Each file is written into the sandbox user's home config scope with every __AS_TOKEN_<host>__ placeholder replaced host-side by the matching registries: token. Placeholders only — never a real secret. A present section is authoritative: the LLM stager is skipped and the template is replayed every run.",
      "required": [
        "files"
      ],
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "array",
          "description": "Global auth-config files to stage inside the sandbox",
          "items": {
            "type": "object",
            "required": [
              "path",
              "content"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "description": "Absolute sandbox path under the user's home config scope (/root/.<dir>/...). Repo-tree, traversal and system paths are rejected.",
                "examples": ["/root/.cargo/credentials.toml", "/root/.pypirc"]
              },
              "content": {
                "type": "string",
                "description": "File body with __AS_TOKEN_<host>__ placeholders where the registry token belongs. Never a real secret."
              }
            }
          }
        }
      }
    }
  }
}